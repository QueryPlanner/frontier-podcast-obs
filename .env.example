# Copy to .env and fill in. Never commit the real file.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate values that need no sanitising -- vdo.ninja rewrites any
# non-alphanumeric character in a stream ID to "_", silently, in the guest's
# browser. A hyphen here means OBS subscribes to an ID nobody is publishing,
# with no error anywhere. See "Identifiers" in the README.
#
#   export VDO_ROOM=frontier$(openssl rand -hex 4)
#   export VDO_GUEST_ID=guest$(openssl rand -hex 4)
#   export VDO_PARTH_ID=parth$(openssl rand -hex 4)
#   export VDO_CHIRAG_ID=chirag$(openssl rand -hex 4)
#   export VDO_PASSWORD=$(openssl rand -hex 12)

export VDO_ROOM=
export VDO_GUEST_ID=
export VDO_PARTH_ID=
export VDO_CHIRAG_ID=
export VDO_PASSWORD=
